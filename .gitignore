# 系統暫存
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.log

# 編輯器暫存
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*~
.editorconfig

# Obsidian workspace（本地設置不同步）
.obsidian/workspace
.obsidian/workspace.json
.obsidian/cache
.obsidian/.DS_Store
obsidian/workspace
obsidian/workspace.json

# Node modules（如有使用）
node_modules/
package-lock.json

# Python 快取
__pycache__/
*.pyc

# 環境變數
.env
.env.local

# 輸出資料夾（勿追蹤生成檔案）
# 用 output/* 而非 output/：git 不會進入被排除的「目錄」，
# 寫成 output/ 的話下面那條 ! 例外規則不會生效
output/*
dist/
# 例外：燒價圖的樣式決策範本，是 burn_price.ps1 現行版面的由來，值得留存
!output/price-overlay-preview.html

# 音聲克隆臨時檔
*.wav
temp_*
temp_speech.mp3
